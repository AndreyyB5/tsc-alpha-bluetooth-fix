REM tsc-alpha-bluetooth-fix: Bluetooth fix without reflashing (TSC Alpha-40L, firmware M2.01.002).
REM The printer runs AUTO.BAS at power-on. On any other model or firmware it does nothing.
REM Keeps the Bluetooth module UART at 115200 baud. Remove with: KILL F,"AUTO.BAS"
IF GETSETTING$("SYSTEM","INFORMATION","MODEL")="Alpha-40L" THEN
IF GETSETTING$("SYSTEM","INFORMATION","VERSION")="2.01.002" THEN
IF PEEK32(541189356)=3778019102 THEN
POKE32 579482368,541189356
POKE32 547560292,115200
POKE32 4160913952,106
POKE32 4160913956,3456
DELAY 3000
POKE32 579482368,541189356
POKE32 547560292,115200
POKE32 4160913952,106
POKE32 4160913956,3456
ENDIF
ENDIF
ENDIF
